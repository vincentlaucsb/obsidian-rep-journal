{
  "name": "rep-journal",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && eslint . --max-warnings=0",
    "import": "node src/import-cli.ts",
    "standalone": "node src/standalone-server.ts",
    "test": "node --test tests/*.test.ts",
    "test:ui": "npm run build && playwright test --config tests/e2e/playwright.config.ts"
  },
  "overrides": {
    "moment": "2.31.0",
    "minimatch@>=7 <11.0.1": "11.0.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.20.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "1.13.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@oddbird/popover-polyfill": "0.7.3",
    "svgplot-wasm": "1.0.0"
  }
}
