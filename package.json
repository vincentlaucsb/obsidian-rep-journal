{
  "name": "rep-journal",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.ts"
  },
  "overrides": {
    "moment": "2.31.0",
    "minimatch@>=7 <11.0.1": "11.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "1.13.1",
    "typescript": "^5.9.3"
  }
}
